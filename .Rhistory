delim = ",",
skip = tabs$skip[i],
col_names = eval(parse(text = files$colname_override[i])),
show_col_types = FALSE
) %>%
mutate(
TIMESTAMP = ymd_hms(
TIMESTAMP,
tz = TIMEZONE
),
TIMESTAMP = round_date(TIMESTAMP, "minute")
) %>%
select(any_of(c("TIMESTAMP", vars))) %>%
group_by(TIMESTAMP) %>%
summarize(
across(everything(), ~ mean(.x, na.rm = TRUE)),
.groups = "drop"
)
}
