TIMEZONE <- "EST"
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(lubridate)
library(plotly)
library(DT)
library(SARGEtools)
TIMEZONE <- "EST"
# Define your files
files <- read_delim(
"../SARGE_configuredata/file_descriptions.txt",
show_col_types = FALSE, delim = "\t"
)
# Define your instrumentation, variables, and plotting colors
variables <- read_csv(
"../SARGE_configuredata/variable_descriptions.csv",
show_col_types = FALSE
) %>%
mutate(
default = as.logical(default)
) %>%
mutate(colname = if_else(is.na(colname), label, colname),
label = if_else(is.na(label), colname, label))
# Define the date window you want to plot
start_date = "2026-09-02"
end_date = "2026-09-03"
data <- sarge_read(
files = files,
variables = variables,
timezone = TIMEZONE,
resolution = "minute"
)
# Set the desired data_type from your data (must match a data_type in variables)
data_type = "Physiochemistry"
# Plot the greenhouse gas data from SARGE
exo_plot <- sarge_plot_defaults(
data = data,
data_type = data_type,
start = start_date,
end = end_date,
variables = variables)
# Print the Plot
exo_plot
# Set the desired data_type from your data (must match a data_type in variables)
data_type = "Hydrology"
# Plot the greenhouse gas data from SARGE
adcp_plot <- sarge_plot_defaults(
data = data,
data_type = data_type,
start = start_date,
end = end_date,
variables = variables)
# Print the Plot
adcp_plot
head(data)
# Set the desired data_type from your data (must match a data_type in variables)
data_type = "GHG"
# Plot the greenhouse gas data from SARGE
ghg_plot <- sarge_plot_defaults(
data = data,
data_type = data_type,
start = start_date,
end = end_date,
variables = variables)
# Print the Plot
ghg_plot
# Set the desired data_type from your data (must match a data_type in variables)
data_type = "Radon"
# Plot the greenhouse gas data from SARGE
rad7_plot <- sarge_plot_defaults(
data = data,
data_type = data_type,
start = start_date,
end = end_date,
variables = variables)
# Print the Plot
rad7_plot
